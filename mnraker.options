zstandardRoot = os.environ.get( "REZ_ZSTANDARD_ROOT", "" ).replace("\\", "/")
bloscRoot = os.environ.get( "REZ_BLOSC_ROOT", "" ).replace("\\", "/")

imathSuffix = ''
openimageioSuffix = os.environ['REZ_OPENIMAGEIO_SUFFIX_NAME']
boostPythonSuffix = "".join(os.environ["REZ_PYTHON_VERSION"].split(".")[:2])
#glewSuffix = ''
openvdbSuffix = os.environ['REZ_OPENVDB_SUFFIX_NAME']

imathMajorVersion = os.environ.get( "REZ_IMATH_MAJOR_VERSION" )
imathMinorVersion = os.environ.get( "REZ_IMATH_MINOR_VERSION" )

openexrMajorVersion = os.environ.get( "REZ_OPENEXR_MAJOR_VERSION" )
openexrMinorVersion = os.environ.get( "REZ_OPENEXR_MINOR_VERSION" )

pythonRoot = os.environ.get('REZ_PYTHON_ROOT', "").replace('\\', '/')
pythonBin = pythonRoot + '/bin/python'
pythonLibPath = pythonRoot + '/lib'
pythonVersion = ".".join(os.environ["REZ_PYTHON_VERSION"].split(".")[:2])
pythonIncludePath = pythonRoot + '/include/python' + pythonVersion

boostPythonSuffix = "".join(os.environ["REZ_PYTHON_VERSION"].split(".")[:2])

pythonLinkFlags = '-L{pythonRoot}/lib -lpthread -ldl -lutil -lm'.format(pythonRoot=pythonRoot)
platform = os.environ['REZ_PLATFORM_VERSION']
INKSCAPE = os.environ.get("INKSCAPE_BIN", "inkscape") # todo: make a rez wrapper?
SPHINX = os.environ.get("REZ_SPHINX_ROOT", "sphinx-build") # todo: make a rez wrapper?
if platform == 'windows':
    GLEW_LIB_SUFFIX = "32"
    pythonLinkFlags = ''
    pythonBin = pythonRoot + '/bin/python.exe'
    pythonLibPath = pythonRoot + '/libs'
    pythonIncludePath = pythonRoot + '/include'
    imathSuffix = '-' + os.environ['REZ_IMATH_MAJOR_VERSION'] + "_" + os.environ['REZ_IMATH_MINOR_VERSION']
    INKSCAPE = os.environ.get("INKSCAPE_BIN", "C:\\Program Files\\Inkscape\\bin\\inkscape.exe") # todo: make a rez wrapper?
    ENV_VARS_TO_IMPORT = "PATH REZ_CORTEX_ROOT CORTEX_ROOT OSLHOME PYTHONHOME IECORE_DLL_DIRECTORIES"
elif platform == 'osx':
    pythonLibPath = '{pythonRoot}/lib/Python.framework/Versions/{pythonVersion}/lib'.format(pythonRoot=pythonRoot, pythonVersion=pythonVersion)
    pythonIncludePath = '{pythonRoot}/lib/Python.framework/Headers'.format(pythonRoot=pythonRoot)
    pythonLinkFlags = '-lpython{pythonVersion}'.format(pythonVersion=pythonVersion)
    ENV_VARS_TO_IMPORT = "PATH LD_LIBRARY_PATH REZ_CORTEX_ROOT CORTEX_ROOT OSLHOME PYTHONHOME"
else:
    ENV_VARS_TO_IMPORT = "PATH LD_LIBRARY_PATH REZ_CORTEX_ROOT CORTEX_ROOT OSLHOME PYTHONHOME"

arch = os.environ['REZ_ARCH_VERSION']
if arch == 'AMD64':
	arch = 'x86_64'
elif arch == 'ARM64':
	arch = 'aarch64'
elif arch == 'arm64':
	arch = 'aarch64'

cxxcompiler = os.environ.get("REZ_EPH_CXXCOMPILER_REQUEST", os.environ.get("REZ_BUILD_TOOLCHAIN_CXX_BIN", None))
cxxcompiler = shutil.which( cxxcompiler )

boostSuffix = ''
boostIncludePath = boostRoot + '/include'
boostLayout = os.environ.get('REZ_EPH_BOOST_LAYOUT_REQUEST', '0')
boostCmake = True
boostMajorVersion = os.environ['REZ_BOOST_MAJOR_VERSION']
boostMinorVersion = os.environ['REZ_BOOST_MINOR_VERSION']
if boostLayout == '0':
    boostLayout = 'versioned' if platform == 'windows' else 'system'
if boostLayout == 'versioned':
    boostVersion = boostMajorVersion + "_" + boostMinorVersion
    boostIncludePath += "/boost-" + boostVersion
    if platform == 'windows' : 
        if cxxcompiler == 'clang' :
            boostSuffix += '-clangcl'
        else :
            msvcVer = os.environ.get('REZ_MSVC_TOOLSET_MAJOR_VERSION', '143')
            boostSuffix += '-vc' + msvcVer
    # Always -mt
    boostSuffix += '-mt'
    boostSuffix += '-x64' if arch == 'x86_64' else 'arm'
    boostSuffix += '-' + boostVersion

boostCmake = True
if int(boostMajorVersion) * 10000 + int(boostMinorVersion) * 100 <= 18000:
    boostCmake = False
    cxxFlags.append("-Wno-enum-constexpr-conversion")

BOOST_CMAKE=boostCmake
BOOST_LIB_SUFFIX=boostSuffix
BOOST_PYTHON_LIB_SUFFIX = boostPythonSuffix + boostSuffix
IMATH_LIB_SUFFIX=imathSuffix

